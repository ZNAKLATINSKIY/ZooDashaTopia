rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Любой может читать животных, мероприятия и отзывы
    match /animals/{animal} { allow read: if true; }
    match /events/{event} { allow read: if true; }
    match /reviews/{review} { allow read: if true; allow create: if request.auth != null; }

    // Правила для пользователей (каждый может редактировать только свои данные)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Вложенные коллекции корзины и заказов
      match /cart/{cartItem} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /orders/{order} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}